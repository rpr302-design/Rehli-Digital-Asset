<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.0/dist/katex.min.css" />
<script defer="defer" src="https://cdn.jsdelivr.net/npm/katex@0.16.0/dist/katex.min.js"></script>
<script defer="defer" src="https://cdn.jsdelivr.net/npm/katex@0.16.0/dist/contrib/auto-render.min.js"></script>

<style>
    #quiz-app {
        max-width: 650px;
        margin: 20px auto;
        padding: 25px;
        background: #fff;
        border: 1px solid #eee;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        font-family: sans-serif;
    }
    .q-text { font-size: 1.25rem; margin-bottom: 20px; line-height: 1.5; color: #1a202c; }
    .opt-list { display: flex; flex-direction: column; gap: 10px; }
    .opt-item {
        padding: 12px 15px;
        border: 2px solid #edf2f7;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.2s;
        text-align: left;
        background: #f8fafc;
    }
    .opt-item:hover { border-color: #4299e1; background: #ebf8ff; }
    .opt-item.active { border-color: #4299e1; background: #bee3f8; font-weight: bold; }
    .controls { margin-top: 25px; text-align: right; }
    #next-btn {
        background: #3182ce; color: white; border: none;
        padding: 10px 25px; border-radius: 5px; cursor: pointer;
    }
    #next-btn:disabled { background: #cbd5e0; cursor: not-allowed; }
    #score-page { display: none; text-align: center; }
</style>

<div id="quiz-app">
    <div id="quiz-screen">
        <div id="info" style="font-size: 0.8rem; color: #718096; margin-bottom: 10px;"></div>
        <div id="q-box" class="q-text">प्रश्नावली लोड हो रही है...</div>
        <div id="o-box" class="opt-list"></div>
        <div class="controls">
            <button id="next-btn" onclick="goNext()" disabled>अगला प्रश्न</button>
        </div>
    </div>
    <div id="score-page">
        <h2>क्विज़ पूरा हुआ!</h2>
        <div id="final-score" style="font-size: 2.5rem; color: #3182ce; margin: 20px 0;"></div>
        <button onclick="location.reload()" style="padding: 10px; cursor:pointer;">फिर से खेलें</button>
    </div>
</div>

<script>
// <![CDATA[
const myQuestions = [
    {
        q: "यदि समीकरण $x^2 - 5x + 6 = 0$ है, तो $x$ के मूल (roots) क्या होंगे?",
        o: ["$2, 3$", "$-2, -3$", "$1, 6$", "$0, 5$"],
        a: "$2, 3$"
    },
    {
        q: "त्रिकोणमिति सूत्र: $\\sin^2 \\theta + \\cos^2 \\theta$ का मान क्या है?",
        o: ["$0$", "$1$", "$-1$", "$\\infty$"],
        a: "$1$"
    },
    {
        q: "सर्कल का क्षेत्रफल क्या होता है?",
        o: ["$2 \\pi r$", "$\\pi r^2$", "$2 \\pi d$", "$\\frac{1}{2} \\pi r$"],
        a: "$\\pi r^2$"
    }
];

let currentQ = 0;
let myScore = 0;
let picked = null;

function renderMathNow() {
    if (typeof renderMathInElement === 'function') {
        renderMathInElement(document.getElementById('quiz-app'), {
            delimiters: [
                {left: "$$", right: "$$", display: true},
                {left: "$", right: "$", display: false}
            ],
            throwOnError: false
        });
    } else {
        // अगर लाइब्रेरी लोड नहीं हुई, तो 300ms बाद फिर कोशिश करें
        setTimeout(renderMathNow, 300);
    }
}

function displayQ() {
    const data = myQuestions[currentQ];
    document.getElementById('info').innerText = `प्रश्न ${currentQ + 1} / ${myQuestions.length}`;
    document.getElementById('q-box').innerHTML = data.q;
    
    const oBox = document.getElementById('o-box');
    oBox.innerHTML = "";
    
    data.o.forEach(opt => {
        const div = document.createElement('div');
        div.className = 'opt-item';
        div.innerHTML = opt;
        div.onclick = function() {
            picked = opt;
            document.querySelectorAll('.opt-item').forEach(el => el.classList.remove('active'));
            div.classList.add('active');
            document.getElementById('next-btn').disabled = false;
        };
        oBox.appendChild(div);
    });

    renderMathNow();
}

function goNext() {
    if (picked === myQuestions[currentQ].a) myScore++;
    
    if (currentQ < myQuestions.length - 1) {
        currentQ++;
        picked = null;
        document.getElementById('next-btn').disabled = true;
        displayQ();
    } else {
        document.getElementById('quiz-screen').style.display = 'none';
        document.getElementById('score-page').style.display = 'block';
        document.getElementById('final-score').innerText = `${myScore} / ${myQuestions.length}`;
    }
}

// शुरू करने के लिए थोड़ा डिले ताकि KaTeX तैयार हो जाए
window.addEventListener('load', function() {
    setTimeout(displayQ, 500);
});
// ]]>
</script>
